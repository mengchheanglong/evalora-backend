# Caddy Reverse Proxy Configuration for Evalora Backend
# Automatically manages Let's Encrypt SSL certificates and WebSocket upgrades.

# Option A: With custom domain (uncomment and replace with your actual domain):
# api.yourdomain.com {
#     encode gzip zstd
#     reverse_proxy backend:4000
# }

# Option B: HTTP on port 80 (accessible directly via your Oracle Cloud public IP):
:80 {
    encode gzip zstd
    reverse_proxy backend:4000
}
