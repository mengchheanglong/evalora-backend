# Backend
HOST=0.0.0.0
PORT=4000
# Comma-separated browser origins allowed for CORS (credentials).
FRONTEND_URL=http://localhost:3010,http://localhost:3000
# Public app URL used in invite/assessment email links (defaults to first FRONTEND_URL).
APP_URL=http://localhost:3010
JWT_SECRET=replace-with-local-development-secret

# Google Sign-In (Identity Services ID token audience).
# Create an OAuth 2.0 Web client in Google Cloud Console and add authorized JavaScript origins
# (e.g. http://localhost:3010). Use the same client ID on the frontend as NEXT_PUBLIC_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# Database: PostgreSQL on Neon
# Use the Neon pooled connection string when available. Keep sslmode=require.
DATABASE_URL="postgresql://USER:***@HOST.neon.tech/evalora?sslmode=require"

# ---------------------------------------------------------------------------
# Email delivery (optional). Without a provider, invites still work and return
# emailDelivery.status=skipped so you can copy links manually.
#
# EMAIL_PROVIDER=auto|gmail|resend
#   auto  = use Gmail SMTP if SMTP_USER+SMTP_PASS set, else Resend if API key set
#   gmail = Gmail SMTP only (best free way to reach any inbox for demos)
#   resend = Resend only
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=auto

# --- Gmail SMTP (recommended free demo path) ---
# 1) Enable 2-Step Verification on the Google account
# 2) Create an App Password: https://myaccount.google.com/apppasswords
# 3) Set SMTP_USER to the Gmail address and SMTP_PASS to the 16-char app password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional aliases: GMAIL_USER / GMAIL_APP_PASSWORD
# EMAIL_FROM defaults to: Evalora <SMTP_USER>
# EMAIL_FROM=Evalora <you@gmail.com>

# --- Resend (https://resend.com) ---
# onboarding@resend.dev can ONLY email the address on your Resend account.
# For any recipient: verify a domain at https://resend.com/domains and set EMAIL_FROM.
RESEND_API_KEY=
EMAIL_FROM=

# AI: DeepSeek V4 Flash
AI_PROVIDER=deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=

# Optional generic AI adapter values for local experiments only.
AI_API_KEY=
AI_API_BASE_URL=

# Code execution - powers POST /api/code/run, /grade, /submit.
# Defaults to Judge0 CE. For production, configure a capacity-controlled Judge0
# or self-hosted Piston instance and select it explicitly.
CODE_EXECUTION_PROVIDER=judge0
JUDGE0_API_URL=https://ce.judge0.com
JUDGE0_API_KEY=
JUDGE0_API_KEY_HEADER=
JUDGE0_JAVASCRIPT_LANGUAGE_ID=102

# Piston alternative. Point this at an instance's /api/v2 base.
PISTON_URL=http://localhost:2000/api/v2
# Only needed if your Piston instance is behind an auth proxy:
PISTON_API_KEY=

# Rate limiting for the code-execution endpoints (per client IP, fixed window).
# Defaults: 30 requests per 60s. Tune down for stricter abuse protection.
CODE_RATE_LIMIT_MAX=30
CODE_RATE_LIMIT_WINDOW_MS=60000

# Set ONLY when the API runs behind a reverse proxy/load balancer you control, so
# req.ip (and rate limiting) reads the real client from X-Forwarded-For. Use the
# number of trusted proxy hops (e.g. 1), "true", or a subnet. Leave unset when the
# API is directly exposed, otherwise clients could spoof their source IP.
# TRUST_PROXY=1

# Rate limiting for the unauthenticated auth endpoints (login, register, google,
# forgot/reset password), per client IP, fixed window. Defaults: 20 per 60s.
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=60000

# Rate limiting for AI-assisted template draft generation, per authenticated user,
# fixed window. This route accepts a multi-megabyte upload and spends a paid model
# call, so the budget is deliberately small. Defaults: 10 per hour.
DRAFT_RATE_LIMIT_MAX=10
DRAFT_RATE_LIMIT_WINDOW_MS=3600000
