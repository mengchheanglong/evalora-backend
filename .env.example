# Backend
PORT=4000
FRONTEND_URL=http://localhost:3000
JWT_SECRET=replace-with-local-development-secret

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/evalora

# External services, add real values locally only
AI_API_KEY=
AI_API_BASE_URL=
JUDGE0_API_URL=
JUDGE0_API_KEY=

# Code execution (Piston) - powers POST /api/code/run
# The public emkc.org Piston API is whitelist-only since 2026-02-15, so self-host Piston.
# Point this at your Piston instance's /api/v2 base (no trailing slash needed).
PISTON_URL=http://localhost:2000/api/v2
# Only needed if your Piston instance is behind an auth proxy:
PISTON_API_KEY=
