# Backend
PORT=4000
FRONTEND_URL=http://localhost:3000
JWT_SECRET=replace-with-local-development-secret

# Database: PostgreSQL on Neon
# Use the Neon pooled connection string when available. Keep sslmode=require.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/evalora?sslmode=require"

# AI: DeepSeek V4 Flash
AI_PROVIDER=deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=

# Code execution sandbox
JUDGE0_API_URL=
JUDGE0_API_KEY=
