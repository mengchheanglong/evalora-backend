# Server & Security
PORT=4000
FRONTEND_URL=http://localhost:3010,http://localhost:3000
APP_URL=http://localhost:3010
JWT_SECRET=your-random-32-character-secret-key-here

# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/evalora?sslmode=require"

# Redis Cache (Optional - defaults to in-memory if omitted)
# Local: redis://localhost:6379 | Production (Upstash): rediss://default:TOKEN@HOST.upstash.io:6379
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=evalora:

# AI (DeepSeek V4 Flash)
AI_PROVIDER=deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=your-deepseek-api-key

# Code Execution Sandbox (Judge0 Public CE by default)
CODE_EXECUTION_PROVIDER=judge0
JUDGE0_API_URL=https://ce.judge0.com

# Email Delivery (Gmail SMTP)
EMAIL_PROVIDER=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-16-char-app-password
EMAIL_FROM=Evalora <your-email@gmail.com>

# Google Sign-In (Matches NEXT_PUBLIC_GOOGLE_CLIENT_ID on frontend)
GOOGLE_CLIENT_ID=your-google-oauth-client-id

# LiveKit (Realtime Audio/Video for live interviews)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# ABA PayWay Sandbox (Cambodia Payment Gateway)
PAYWAY_ENV=sandbox
PAYWAY_MERCHANT_ID=your-merchant-id
PAYWAY_API_KEY=your-api-key
PAYWAY_PAYMENT_CALLBACK_URL=https://checkout-sandbox.payway.com.kh/api/payment-gateway/v1/payments/purchase
