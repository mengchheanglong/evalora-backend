generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  ORGANIZATION
  INTERVIEWER
  CANDIDATE
}

enum SessionStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  EXPIRED
}

enum ModuleType {
  AI_INTERVIEW
  CODING
  DEBUGGING
  WORK_STYLE
  BEHAVIORAL
  LEADERSHIP
  COMMUNICATION
  PROBLEM_SOLVING
}

enum QuestionType {
  MCQ
  SCALE
  SHORT_ANSWER
  CODING
  SCENARIO
  ROLEPLAY
}

enum InviteStatus {
  PENDING
  ACCEPTED
  CANCELLED
  EXPIRED
}

model Organization {
  id        String               @id @default(uuid())
  name      String
  users     User[]
  invites   OrganizationInvite[]
  templates AssessmentTemplate[]
  sessions  InterviewSession[]
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @updatedAt @map("updated_at")

  @@map("organizations")
}

model User {
  id                String               @id @default(uuid())
  name              String
  email             String               @unique
  emailVerified     Boolean              @default(false) @map("email_verified")
  passwordHash      String               @map("password_hash")
  role              UserRole
  organizationId    String?              @map("organization_id")
  organization      Organization?        @relation(fields: [organizationId], references: [id])
  createdTemplates  AssessmentTemplate[] @relation("TemplateCreator")
  candidateSessions InterviewSession[]   @relation("CandidateSessions")
  createdSessions   InterviewSession[]   @relation("SessionCreator")
  reviewerNotes     ReviewerNote[]
  sentInvites       OrganizationInvite[] @relation("InviteSender")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  @@map("users")
}

/// Workspace invite for teammates (interviewers). Owners invite; invitees join the same organization.
model OrganizationInvite {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  /// Invite role is always INTERVIEWER for MVP; stored for future expansion.
  role           UserRole     @default(INTERVIEWER)
  token          String       @unique
  status         InviteStatus @default(PENDING)
  invitedById    String       @map("invited_by_id")
  invitedBy      User         @relation("InviteSender", fields: [invitedById], references: [id])
  expiresAt      DateTime     @map("expires_at")
  acceptedAt     DateTime?    @map("accepted_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@index([organizationId, status])
  @@index([email])
  @@map("organization_invites")
}

model AssessmentTemplate {
  id             String             @id @default(uuid())
  title          String
  description    String?
  roleType       String             @map("role_type")
  timeLimitMin   Int?               @map("time_limit_min")
  scoringRules   Json?              @map("scoring_rules")
  createdById    String             @map("created_by_id")
  createdBy      User               @relation("TemplateCreator", fields: [createdById], references: [id])
  organizationId String?            @map("organization_id")
  organization   Organization?      @relation(fields: [organizationId], references: [id])
  modules        AssessmentModule[]
  sessions       InterviewSession[]
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  @@index([organizationId])
  @@map("assessment_templates")
}

model AssessmentModule {
  id          String             @id @default(uuid())
  templateId  String             @map("template_id")
  template    AssessmentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  moduleType  ModuleType         @map("module_type")
  title       String
  description String?
  weight      Float              @default(1)
  orderIndex  Int                @map("order_index")
  settings    Json?
  questions   Question[]
  evaluations Evaluation[]
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  @@map("assessment_modules")
}

model Question {
  id           String           @id @default(uuid())
  moduleId     String           @map("module_id")
  module       AssessmentModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  questionText String           @map("question_text")
  questionType QuestionType     @map("question_type")
  options      Json?
  rubric       Json?
  responses    Response[]
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  @@map("questions")
}

model InterviewSession {
  id              String             @id @default(uuid())
  candidateId     String             @map("candidate_id")
  candidate       User               @relation("CandidateSessions", fields: [candidateId], references: [id])
  templateId      String             @map("template_id")
  template        AssessmentTemplate @relation(fields: [templateId], references: [id])
  organizationId  String?            @map("organization_id")
  organization    Organization?      @relation(fields: [organizationId], references: [id])
  createdById     String?            @map("created_by_id")
  createdBy       User?              @relation("SessionCreator", fields: [createdById], references: [id])
  /// Workspace label from the create-session form (optional).
  title           String?
  interviewType   String?            @map("interview_type")
  /// Named interviewers assigned on the workspace form (string array JSON).
  interviewers    Json?
  notes           String?
  /// Role/position for this session; falls back to template.roleType when unset.
  targetRole      String?            @map("target_role")
  department      String?
  scheduledAt     DateTime?          @map("scheduled_at")
  durationMin     Int?               @map("duration_min")
  language        String?
  timeZone        String?            @map("time_zone")
  accessCode      String             @unique @map("access_code")
  status          SessionStatus      @default(NOT_STARTED)
  startedAt       DateTime?          @map("started_at")
  completedAt     DateTime?          @map("completed_at")
  expiresAt       DateTime?          @map("expires_at")
  responses       Response[]
  aiMessages      AIMessage[]
  codeSubmissions CodeSubmission[]
  evaluations     Evaluation[]
  report          CandidateReport?
  reviewerNotes   ReviewerNote[]
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  @@index([organizationId, status])
  @@index([organizationId, status, expiresAt])
  @@index([organizationId, completedAt])
  @@index([organizationId, updatedAt])
  @@index([status, expiresAt])
  @@index([status, completedAt])
  @@map("interview_sessions")
}

model Response {
  id           String           @id @default(uuid())
  sessionId    String           @map("session_id")
  session      InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId   String?          @map("question_id")
  question     Question?        @relation(fields: [questionId], references: [id])
  responseText String           @map("response_text")
  responseJson Json?            @map("response_json")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  // One stored answer per (session, question) so a double-submit / retry updates
  // rather than inserting a duplicate. questionId is nullable and Postgres treats
  // NULLs as distinct, so AI-interview responses (no questionId) are unconstrained.
  @@unique([sessionId, questionId])
  @@map("responses")
}

model AIMessage {
  id        String           @id @default(uuid())
  sessionId String           @map("session_id")
  session   InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  content   String
  metadata  Json?
  createdAt DateTime         @default(now()) @map("created_at")

  @@map("ai_messages")
}

model CodeSubmission {
  id            String           @id @default(uuid())
  sessionId     String           @map("session_id")
  session       InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId    String           @map("question_id")
  language      String
  sourceCode    String           @map("source_code")
  stdout        String           @default("")
  stderr        String           @default("")
  compileOutput String           @default("") @map("compile_output")
  status        String
  executionTime Float            @default(0) @map("execution_time")
  score         Float            @default(0)
  testResults   Json?            @map("test_results")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  @@index([sessionId])
  @@index([questionId])
  @@map("code_submissions")
}

model Evaluation {
  id             String            @id @default(uuid())
  sessionId      String            @map("session_id")
  session        InterviewSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  moduleId       String?           @map("module_id")
  module         AssessmentModule? @relation(fields: [moduleId], references: [id])
  score          Float
  feedback       String
  evidence       Json?
  criteriaScores Json?             @map("criteria_scores")
  createdAt      DateTime          @default(now()) @map("created_at")

  @@index([sessionId, createdAt])
  @@map("evaluations")
}

model CandidateReport {
  id               String           @id @default(uuid())
  sessionId        String           @unique @map("session_id")
  session          InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  overallScore     Float            @map("overall_score")
  moduleScores     Json             @map("module_scores")
  summary          String
  strengths        Json
  improvementAreas Json             @map("improvement_areas")
  evidence         Json
  reviewerSummary  String?          @map("reviewer_summary")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  @@map("candidate_reports")
}

model ReviewerNote {
  id         String           @id @default(uuid())
  sessionId  String           @map("session_id")
  session    InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  reviewerId String           @map("reviewer_id")
  reviewer   User             @relation(fields: [reviewerId], references: [id])
  note       String
  createdAt  DateTime         @default(now()) @map("created_at")

  @@map("reviewer_notes")
}
